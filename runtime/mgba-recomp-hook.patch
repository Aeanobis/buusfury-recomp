diff --git a/src/arm/arm.c b/src/arm/arm.c
index 37dfe72..520a4b5 100644
--- a/src/arm/arm.c
+++ b/src/arm/arm.c
@@ -236,13 +236,79 @@ void ARMRun(struct ARMCore* cpu) {
 	}
 }
 
+// --- static recompilation hook (lgoku-recomp) ---
+// Each region maps guest addresses to natively compiled blocks. A NULL entry
+// means the address was not statically translated; the interpreter runs it.
+// Regions backed by RAM carry the code image the blocks were compiled from and
+// are only used while the live memory still matches it.
+typedef void (*RecompBlock)(struct ARMCore*);
+struct RecompRegion {
+	uint32_t base;
+	uint32_t size;
+	RecompBlock* table[2];        // [thumb][offset >> 1]
+	const uint8_t* image;         // NULL for read-only regions
+	const uint16_t* guardLen[2];  // bytes to compare against image, per block
+};
+struct RecompRegion recompRegions[3]; // ROM, BIOS, IWRAM
+int recompEnabled = 0;
+uint64_t recompBlocksRun = 0;
+uint64_t recompInterpreted = 0;
+void (*recompMiss)(uint32_t pc, int thumb) = NULL;
+static uint32_t recompSeqNext = 0xFFFFFFFF;
+
 void ARMRunLoop(struct ARMCore* cpu) {
-	if (cpu->executionMode == MODE_THUMB) {
-		while (cpu->cycles < cpu->nextEvent) {
-			ThumbStep(cpu);
+	if (!recompEnabled) {
+		if (cpu->executionMode == MODE_THUMB) {
+			while (cpu->cycles < cpu->nextEvent) {
+				ThumbStep(cpu);
+			}
+		} else {
+			while (cpu->cycles < cpu->nextEvent) {
+				ARMStep(cpu);
+			}
 		}
-	} else {
-		while (cpu->cycles < cpu->nextEvent) {
+		cpu->irqh.processEvents(cpu);
+		return;
+	}
+	while (cpu->cycles < cpu->nextEvent) {
+		int thumb = cpu->executionMode == MODE_THUMB;
+		uint32_t pc = cpu->gprs[ARM_PC] - (thumb ? WORD_SIZE_THUMB : WORD_SIZE_ARM);
+		const struct RecompRegion* r = NULL;
+		uint32_t off = pc - recompRegions[0].base;
+		if (off < recompRegions[0].size) {
+			r = &recompRegions[0];
+		} else if (pc < recompRegions[1].size) {
+			r = &recompRegions[1];
+			off = pc;
+		} else if (pc - recompRegions[2].base < recompRegions[2].size) {
+			r = &recompRegions[2];
+			off = pc - recompRegions[2].base;
+		}
+		if (r) {
+			RecompBlock fn = r->table[thumb][off >> 1];
+			if (fn && r->image) {
+				const uint8_t* live = (const uint8_t*) cpu->memory.activeRegion + (pc & cpu->memory.activeMask);
+				if (memcmp(live, r->image + off, r->guardLen[thumb][off >> 1])) {
+					fn = NULL;
+				}
+			}
+			if (fn) {
+				++recompBlocksRun;
+				recompSeqNext = 0xFFFFFFFF;
+				fn(cpu);
+				continue;
+			}
+		}
+		// Only report addresses reached by a jump: those are where blocks must start
+		if (recompMiss && pc != recompSeqNext) {
+			recompMiss(pc, thumb);
+		}
+		++recompInterpreted;
+		if (thumb) {
+			recompSeqNext = pc + WORD_SIZE_THUMB;
+			ThumbStep(cpu);
+		} else {
+			recompSeqNext = pc + WORD_SIZE_ARM;
 			ARMStep(cpu);
 		}
 	}
